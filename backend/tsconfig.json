{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": "..",
        "paths": {
            "@shared/*": [
                "../shared/*"
            ]
        },
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*",
        "src/scripts/seedTestData.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}